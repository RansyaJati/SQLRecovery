<ui:FluentWindow x:Class="SQLRecovery.App.Views.ExportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Export data"
                 Width="600" Height="720"
                 MinWidth="520" MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource BrushSurfaceBase}">

    <Grid Background="{StaticResource BrushSurfaceBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Export data"
                     ShowMinimize="False"
                     ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,16">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextStyle}" Text="Export table" />
                <TextBlock x:Name="SubHeaderText" Style="{StaticResource SubtitleTextStyle}"
                           Margin="0,4,0,24" TextWrapping="Wrap" />

                <TextBlock Text="FORMAT" Style="{StaticResource SectionHeaderStyle}" />
                <ComboBox x:Name="FormatCombo"
                          Style="{StaticResource AppComboBoxStyle}"
                          Margin="0,8,0,0"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="FormatCombo_OnSelectionChanged" />
                <TextBlock x:Name="FormatHint" Style="{StaticResource CaptionTextStyle}"
                           Margin="2,7,0,0" TextWrapping="Wrap" />

                <TextBlock Text="DESTINATION" Style="{StaticResource SectionHeaderStyle}" Margin="0,22,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DestinationBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             IsReadOnly="True" />
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Style="{StaticResource SubtleButtonStyle}"
                            Margin="8,0,0,0"
                            Click="Browse_OnClick" />
                </Grid>

                <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeaderStyle}" Margin="0,22,0,0" />
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0" Padding="16,14">
                    <StackPanel>
                        <CheckBox x:Name="HeadersCheck"
                                  Content="Include column headers"
                                  Style="{StaticResource AppCheckBoxStyle}"
                                  IsChecked="True" />
                        <CheckBox x:Name="CreateTableCheck"
                                  Content="Include CREATE TABLE statement (SQL script)"
                                  Style="{StaticResource AppCheckBoxStyle}"
                                  IsChecked="True"
                                  Margin="0,12,0,0" />
                        <CheckBox x:Name="JsonLinesCheck"
                                  Content="Newline-delimited JSON (one object per line)"
                                  Style="{StaticResource AppCheckBoxStyle}"
                                  Margin="0,12,0,0" />
                        <CheckBox x:Name="IndentedCheck"
                                  Content="Pretty-print JSON"
                                  Style="{StaticResource AppCheckBoxStyle}"
                                  IsChecked="True"
                                  Margin="0,12,0,0" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Target SQL dialect" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,6" />
                                <ComboBox x:Name="DialectCombo"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rows per INSERT batch" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,6" />
                                <TextBox x:Name="BatchSizeBox"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         Text="1000" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="CSV delimiter" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,6" />
                                <ComboBox x:Name="DelimiterCombo"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushAccentFaint}"
                        BorderBrush="#337C3AED"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" FontSize="16"
                                       Foreground="{StaticResource BrushAccentHover}"
                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="Export runs in the background. Progress and results are shown on the main window status bar." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource BrushSurfaceAlt}"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SubtleButtonStyle}"
                        MinWidth="96"
                        Click="Cancel_OnClick" />
                <Button Content="Export"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110"
                        Margin="10,0,0,0"
                        Click="Export_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
